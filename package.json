{
  "name": "sample-access-poc",
  "version": "0.1.0",
  "description": "POC to verify which access rights a Nexus app has on the Audiotool Sample Library",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sample": "tsx src/cli.ts"
  },
  "keywords": [
    "audiotool",
    "nexus",
    "sample",
    "poc"
  ],
  "license": "MIT",
  "dependencies": {
    "@audiotool/nexus": "0.0.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.13",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
